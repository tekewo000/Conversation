package conversation

import "core:os"
import "core:encoding/json"
import "core:strings"
import "core:testing"

@(test)
notes_and_rebuild_schema_migrate_without_history_loss :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-note-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","original")==1)
 testing.expect_value(t,scalar("SELECT count(*) FROM sqlite_master WHERE name IN ('message_annotations','episode_rebuilds')"),2)
 testing.expect_value(t,scalar("PRAGMA user_version"),7)
 testing.expect_value(t,conversation_message_count(),1)
 assert(execute("DROP TABLE message_annotations; DROP TABLE episode_rebuilds; PRAGMA user_version=6"))
 conversation_close()
 assert(conversation_init(c))
 testing.expect_value(t,conversation_message_count(),1)
 testing.expect_value(t,scalar("PRAGMA user_version"),7)
}

@(test)
notes_are_immutable_evidence_and_bounded_rebuild_batches :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-note-api-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_note("scene","喫茶店にいる")==1)
 assert(conversation_add_note("meta","落ち着いた場面")==2)
 testing.expect_value(t,conversation_add_note("invalid","text"),0)
 testing.expect_value(t,conversation_message_count(),2)
 assert(conversation_load_window(0,2))
 testing.expect_value(t,string(conversation_message_annotation(0)),"scene")
 testing.expect_value(t,string(conversation_message_annotation(1)),"meta")
 testing.expect(t,strings.contains(string(conversation_pending_job()),`"annotation":"scene"`))
 testing.expect(t,strings.contains(string(conversation_context("")),`"annotation":"meta"`))
 testing.expect(t,conversation_rebuild_batch(-1,2)==nil)
 testing.expect(t,conversation_rebuild_batch(0,3)==nil)
 testing.expect(t,strings.contains(string(conversation_rebuild_batch(0,2)),`"boundary_id":2`))
 testing.expect(t,!execute("UPDATE message_annotations SET kind='meta' WHERE message_id=1"))
 testing.expect(t,!execute("DELETE FROM message_annotations"))
 testing.expect(t,!conversation_publish_rebuild())
 testing.expect_value(t,scalar("SELECT count(*) FROM messages"),2)
 archive:=strings.clone_to_cstring(string(conversation_archive_delta(0)))
 defer delete(archive)
 conversation_close()
 restored:=strings.concatenate({dir,"/restored"})
 defer delete(restored)
 rc:=strings.clone_to_cstring(restored)
 defer delete(rc)
 assert(conversation_init(rc))
 assert(conversation_apply_archive(archive))
 testing.expect_value(t,scalar("SELECT count(*) FROM message_annotations"),2)
}

REBUILD_ROOT :: `{"key":"trip","text":"京都への旅行","emotion":"安心","scene":"京都","scope":"real","source_ids":[1]}`
REBUILD_CHILD :: `{"key":"cafe","text":"喫茶店にいた","emotion":"落ち着いた","scene":"喫茶店","scope":"real","source_ids":[1]}`

make_rebuild_stage :: proc(dir:string,boundary,cursor:i64) {
 stage_path:=strings.concatenate({dir,"/.memory-rebuild.sqlite3"})
 defer delete(stage_path)
 path:=strings.clone_to_cstring(stage_path)
 defer delete(path)
 stage:SQLite
 assert(sqlite3_open_v2(path,&stage,6,nil)==0)
 defer sqlite3_close(stage)
 assert(sqlite3_exec(stage,`CREATE TABLE meta(key TEXT PRIMARY KEY,value TEXT NOT NULL); CREATE TABLE nodes(root_key TEXT,key TEXT,parent_key TEXT,depth INTEGER,node TEXT,path TEXT,PRIMARY KEY(root_key,key));`,nil,nil,nil)==0)
 stmt:=rebuild_prepare(stage,"INSERT INTO meta VALUES('boundary',?1),('cursor',?2),('roots',?3),('request_id','12345678-1234-1234-1234-123456789abc')")
 assert(stmt!=nil)
 assert(bind_int(stmt,1,boundary) && bind_int(stmt,2,cursor) && bind_text(stmt,3,"["+REBUILD_ROOT+"]") && sqlite3_step(stmt)==101)
 sqlite3_finalize(stmt)
 stmt=rebuild_prepare(stage,"INSERT INTO nodes VALUES('trip','trip','',0,?1,'京都'),('trip','cafe','trip',1,?2,'京都 / 喫茶店')")
 assert(bind_text(stmt,1,REBUILD_ROOT) && bind_text(stmt,2,REBUILD_CHILD) && sqlite3_step(stmt)==101)
 sqlite3_finalize(stmt)
}

@(test)
rebuild_publication_preserves_history_retries_and_replays :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-rebuild-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","京都旅行で喫茶店へ行った")==1)
 assert(conversation_add_message("assistant","安心できたね")==2)
 assert(conversation_apply_job(1,TREE_FIXTURE))
 before_memories:=scalar("SELECT count(*) FROM memories")
 before_jobs:=scalar("SELECT count(*) FROM jobs")
 make_rebuild_stage(dir,2,1)
 testing.expect(t,!conversation_publish_rebuild())
 testing.expect_value(t,scalar("SELECT count(*) FROM memories"),before_memories)
 stage_path:=strings.concatenate({dir,"/.memory-rebuild.sqlite3"})
 defer delete(stage_path)
 path:=strings.clone_to_cstring(stage_path)
 defer delete(path)
 stage:SQLite
 assert(sqlite3_open_v2(path,&stage,2,nil)==0)
 defer sqlite3_close(stage)
 assert(sqlite3_exec(stage,"UPDATE meta SET value='2' WHERE key='cursor'",nil,nil,nil)==0)
 testing.expect(t,conversation_publish_rebuild())
 if string(conversation_error())!="" do testing.expect(t,false,string(conversation_error()))
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_rebuilds"),1)
 testing.expect_value(t,scalar("SELECT count(*) FROM messages"),2)
 testing.expect_value(t,scalar("SELECT count(*) FROM jobs"),before_jobs)
 testing.expect_value(t,scalar("SELECT count(*) FROM memories"),before_memories+2)
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"12345678123412341234123456789abctrip"`))
 query:cstring=`{"root_key":"12345678123412341234123456789abctrip","parent_key":"12345678123412341234123456789abctrip","scope":"real","after_id":0}`
 testing.expect(t,strings.contains(string(conversation_episode_children(query)),`"key":"cafe"`))
 journal:=scalar("SELECT count(*) FROM archive_transactions")
 testing.expect(t,conversation_publish_rebuild())
 testing.expect_value(t,scalar("SELECT count(*) FROM archive_transactions"),journal)
 assert(sqlite3_exec(stage,`UPDATE nodes SET node=json_set(node,'$.text','changed') WHERE key='cafe'`,nil,nil,nil)==0)
 testing.expect(t,!conversation_publish_rebuild())
 testing.expect_value(t,scalar("SELECT count(*) FROM memories"),before_memories+2)
 assert(sqlite3_exec(stage,`UPDATE nodes SET node=json_set(node,'$.text','喫茶店にいた') WHERE key='cafe'`,nil,nil,nil)==0)
 assert(conversation_add_message("user","後から増えた原文")==3)
 // A completed request remains retryable after newer messages arrive.
 testing.expect(t,conversation_publish_rebuild())
 assert(sqlite3_exec(stage,"UPDATE meta SET value='22345678-1234-1234-1234-123456789abc' WHERE key='request_id'",nil,nil,nil)==0)
 testing.expect(t,!conversation_publish_rebuild())
 testing.expect(t,strings.contains(string(conversation_error()),"New messages"))
 archive:=strings.clone_to_cstring(string(conversation_archive_delta(0)))
 defer delete(archive)
 conversation_close()
 restored:=strings.concatenate({dir,"/restored"})
 defer delete(restored)
 rc:=strings.clone_to_cstring(restored)
 defer delete(rc)
 assert(conversation_init(rc))
 testing.expect(t,conversation_apply_archive(archive))
 if string(conversation_error())!="" do testing.expect(t,false,string(conversation_error()))
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_rebuilds"),1)
 testing.expect_value(t,scalar("SELECT count(*) FROM memories"),before_memories+2)
 testing.expect(t,strings.contains(string(conversation_episode_children(query)),`"key":"cafe"`))
}


@(test)
annotated_sources_do_not_supply_reciprocal_dialogue :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-note-evidence-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 for _ in 0..<6 {
  assert(conversation_add_note("meta","関係への注記")>0)
  assert(conversation_add_message("assistant","返事")>0)
 }
 testing.expect(t,!conversation_apply_job(12,`{"first_job_id":1,"memories":[],"continuity":{"threads":[],"episodes":[],"relationship":{"trust":"信頼","openness":"話せる","basis":"注記と返事","source_ids":[1,2]}}}`))
 testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),0)
 assert(conversation_apply_job(12,`{"first_job_id":1,"memories":[]}`))
 testing.expect(t,!conversation_apply_persona(12,`{"changes":[{"field":"preferences","text":"短く話す","reason":"注記","source_ids":[1,2,3,4]}]}`))
 testing.expect_value(t,scalar("SELECT count(*) FROM persona_revisions"),0)
}

@(test)
rebuild_batches_bound_large_history_and_preserve_originals :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-rebuild-budget-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 padding:=strings.repeat("あ\\\"",3000)
 defer delete(padding)
 text:=strings.clone_to_cstring(padding)
 defer delete(text)
 for _ in 0..<30 { assert(conversation_add_note("scene",text)>0) }
 batch:=conversation_rebuild_batch(0,30)
 testing.expect(t,batch!=nil && len(string(batch))<=MEMORY_BATCH_BYTES)
 value,ok:=parse_json(transmute([]byte)string(batch))
 assert(ok)
 defer json.destroy_value(value)
 obj:=value.(json.Object)
 through:=i64(obj["through_id"].(json.Integer))
 testing.expect(t,through>0 && through<30)
 messages:=obj["messages"].(json.Array)
 testing.expect_value(t,i64(len(messages)),through)
 for item,i in messages {
  row:=item.(json.Object)
  testing.expect_value(t,i64(row["id"].(json.Integer)),i64(i+1))
  testing.expect(t,bool(row["truncated"].(json.Boolean)))
 }
 testing.expect(t,conversation_rebuild_batch(through,30)!=nil)
 testing.expect_value(t,scalar("SELECT count(*) FROM messages WHERE length(content)=9000"),30)
}


@(test)
note_metadata_failure_rolls_back_message_job_and_journal :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-note-atomic-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(execute("CREATE TRIGGER reject_annotation BEFORE INSERT ON message_annotations BEGIN SELECT RAISE(ABORT,'test'); END"))
 testing.expect_value(t,conversation_add_note("scene","保存失敗"),0)
 testing.expect_value(t,conversation_message_count(),0)
 testing.expect_value(t,scalar("SELECT (SELECT count(*) FROM messages)+(SELECT count(*) FROM jobs)+(SELECT count(*) FROM archive_transactions)"),0)
}

@(test)
rebuild_archive_budget_rolls_back_every_published_row :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-rebuild-atomic-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","原文を守る")==1)
 assert(conversation_add_message("assistant","そのまま残す")==2)
 make_rebuild_stage(dir,2,2)
 stage_path:=strings.concatenate({dir,"/.memory-rebuild.sqlite3"})
 defer delete(stage_path)
 path:=strings.clone_to_cstring(stage_path)
 defer delete(path)
 stage:SQLite
 assert(sqlite3_open_v2(path,&stage,2,nil)==0)
 defer sqlite3_close(stage)
 assert(sqlite3_exec(stage,"DELETE FROM nodes WHERE key='cafe'",nil,nil,nil)==0)
 stmt:=rebuild_prepare(stage,`WITH RECURSIVE numbers(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM numbers WHERE n<4096) INSERT INTO nodes SELECT 'trip','n'||n,'trip',1,json_object('key','n'||n,'text',?1,'emotion',?2,'scene',?3,'scope','real','source_ids',json('[1]')),'' FROM numbers`)
 assert(stmt!=nil)
 text:=strings.repeat("t",1536)
 emotion:=strings.repeat("e",768)
 scene:=strings.repeat("s",256)
 defer { delete(text); delete(emotion); delete(scene) }
 assert(bind_text(stmt,1,text) && bind_text(stmt,2,emotion) && bind_text(stmt,3,scene) && sqlite3_step(stmt)==101)
 sqlite3_finalize(stmt)
 journal:=scalar("SELECT count(*) FROM archive_transactions")
 testing.expect(t,!conversation_publish_rebuild())
 testing.expect(t,strings.contains(string(conversation_error()),"16 MiB"))
 testing.expect_value(t,scalar("SELECT (SELECT count(*) FROM memories)+(SELECT count(*) FROM episode_nodes)+(SELECT count(*) FROM episode_rebuilds)"),0)
 testing.expect_value(t,scalar("SELECT count(*) FROM messages"),2)
 testing.expect_value(t,scalar("SELECT count(*) FROM jobs"),1)
 testing.expect_value(t,scalar("SELECT count(*) FROM archive_transactions"),journal)
 stmt=rebuild_prepare(stage,"SELECT count(*) FROM nodes")
 assert(sqlite3_step(stmt)==100)
 testing.expect_value(t,sqlite3_column_int64(stmt,0),4097)
 sqlite3_finalize(stmt)
}

@(test)
rebuild_roots_advance_normally_without_erasing_other_continuity :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-rebuild-state-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","旅行のことを話す")==1)
 assert(conversation_add_message("assistant","聞いて安心した")==2)
 assert(conversation_apply_job(1,`{"memories":[],"continuity":{"threads":[{"key":"travel","text":"旅行の話","status":"active","source_ids":[1]}],"episodes":[],"assistant_state":{"emotion":"安心","reason":"話を聞いた","event":"旅行","scope":"shared","source_ids":[1,2]},"relationship":{"trust":"信頼できる","openness":"話せる","basis":"やり取りした","source_ids":[1,2]}}}`))
 make_rebuild_stage(dir,2,2)
 assert(conversation_publish_rebuild())
 state:=string(conversation_context(""))
 testing.expect(t,strings.contains(state,`"key":"12345678123412341234123456789abctrip"`))
 testing.expect(t,strings.contains(state,`"trust":"信頼できる"`))
 testing.expect(t,strings.contains(state,`"emotion":"安心"`))
 testing.expect(t,strings.contains(state,`"key":"travel"`))
 assert(conversation_add_message("user","話の続き")==3)
 assert(conversation_add_message("assistant","うん")==4)
 assert(conversation_apply_job(2,`{"memories":[],"continuity":{"threads":[],"episodes":[{"key":"12345678123412341234123456789abctrip","text":"続きの旅行の話","emotion":"安心","scene":"京都","scope":"real","source_ids":[1,3]}]}}`))
 state=string(conversation_context(""))
 testing.expect(t,strings.contains(state,"続きの旅行の話"))
 testing.expect(t,strings.contains(state,`"trust":"信頼できる"`))
 testing.expect(t,conversation_publish_rebuild())
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_rebuilds"),1)
 testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),2)
}

@(test)
rebuild_indexes_historical_roots_outside_current_summaries :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-rebuild-old-roots-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","昔の旅行の記録")==1)
 make_rebuild_stage(dir,1,1)
 stage_path:=strings.concatenate({dir,"/.memory-rebuild.sqlite3"})
 defer delete(stage_path)
 path:=strings.clone_to_cstring(stage_path)
 defer delete(path)
 stage:SQLite
 assert(sqlite3_open_v2(path,&stage,2,nil)==0)
 defer sqlite3_close(stage)
 assert(sqlite3_exec(stage,`WITH RECURSIVE numbers(n) AS (SELECT 1 UNION ALL SELECT n+1 FROM numbers WHERE n<31) INSERT INTO nodes SELECT 'past'||n,'past'||n,'',0,json_object('key','past'||n,'text','以前の記録','emotion','','scene','過去','scope','real','source_ids',json('[1]')),'過去' FROM numbers`,nil,nil,nil)==0)
 testing.expect(t,conversation_publish_rebuild())
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_nodes"),33)
 testing.expect_value(t,scalar("SELECT json_array_length(roots) FROM episode_rebuilds"),1)
 testing.expect(t,strings.contains(string(conversation_memories("以前の記録")),"以前の記録"))
}

@(test)
rebuild_rejects_noninteger_staged_depth_atomically :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-rebuild-types-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","記録")==1)
 make_rebuild_stage(dir,1,1)
 stage_path:=strings.concatenate({dir,"/.memory-rebuild.sqlite3"})
 defer delete(stage_path)
 path:=strings.clone_to_cstring(stage_path)
 defer delete(path)
 stage:SQLite
 assert(sqlite3_open_v2(path,&stage,2,nil)==0)
 defer sqlite3_close(stage)
 assert(sqlite3_exec(stage,"UPDATE nodes SET depth=1.5 WHERE key='cafe'",nil,nil,nil)==0)
 testing.expect(t,!conversation_publish_rebuild())
 testing.expect_value(t,scalar("SELECT count(*) FROM memories"),0)
}

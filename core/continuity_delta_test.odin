package conversation

import "core:encoding/json"
import "core:fmt"
import "core:os"
import "core:strings"
import "core:testing"

@(test)
continuity_delta_catches_up_with_published_rebuild_without_future_evidence :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-delta-rebuild-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 for _ in 0..<3 {
  assert(conversation_add_message("user","旅行の話")>0)
  assert(conversation_add_message("assistant","聞いている")>0)
 }
 make_rebuild_stage(dir,6,6)
 stage_path:=strings.concatenate({dir,"/.memory-rebuild.sqlite3"})
 defer delete(stage_path)
 path:=strings.clone_to_cstring(stage_path)
 defer delete(path)
 stage:SQLite
 assert(sqlite3_open_v2(path,&stage,2,nil)==0)
 assert(sqlite3_exec(stage,`UPDATE nodes SET node=json_set(node,'$.source_ids',json('[5]')); UPDATE meta SET value=json_set(value,'$[0].source_ids',json('[5]')) WHERE key='roots'`,nil,nil,nil)==0)
 assert(sqlite3_close(stage)==0)
 assert(conversation_publish_rebuild(),string(conversation_error()))
 testing.expect_value(t,scalar("SELECT count(*) FROM jobs WHERE processed=0"),3)
 testing.expect(t,!conversation_apply_job(1,`{"memories":[],"continuity_delta":{"episodes":[{"key":"future","text":"future","emotion":"","scene":"scene","scope":"real","source_ids":[5]}]}}`),"Incoming changes still cannot use future evidence.")
 good :: `{"memories":[],"continuity_delta":{"episodes":[{"key":"normal","text":"normal early event","emotion":"","scene":"scene","scope":"real","source_ids":[1]}]}}`
 testing.expect(t,conversation_apply_job(1,good),string(conversation_error()))
 if string(conversation_error())!="" do return
 testing.expect_value(t,scalar("SELECT json_array_length(state,'$.episodes') FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.episodes[0].key')='normal' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"12345678123412341234123456789abctrip"`),"The completed rebuild stays available in current context.")
 assert(conversation_apply_job(2,`{"memories":[],"continuity_delta":{}}`))
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.episodes[0].key')='normal' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 assert(conversation_apply_job(3,`{"memories":[],"continuity_delta":{"episodes":[{"key":"catchup","text":"catchup event","emotion":"","scene":"scene","scope":"real","source_ids":[5]}]}}`))
 testing.expect_value(t,scalar("SELECT json_array_length(state,'$.episodes') FROM continuity_revisions ORDER BY id DESC LIMIT 1"),2)
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.episodes[0].key')='12345678123412341234123456789abctrip' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"catchup"`),"The newer normal publication wins immediately at the same boundary.")
 testing.expect_value(t,scalar("SELECT (SELECT created_at FROM continuity_revisions ORDER BY id DESC LIMIT 1)>(SELECT created_at FROM episode_rebuilds ORDER BY id DESC LIMIT 1)"),1)
 assert(conversation_export(c))
 // Reconstructing the journal table-wise models snapshot restoration without publication-order metadata.
 assert(execute("DELETE FROM archive_events; DELETE FROM archive_transactions; DELETE FROM meta WHERE key='archive_version'"))
 assert(conversation_init(c))
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"catchup"`),"Backfill must not resurrect the older same-boundary rebuild.")
 assert(conversation_add_message("user","続きの話")>0)
 assert(conversation_add_message("assistant","続けよう")>0)
 assert(conversation_apply_job(4,`{"memories":[],"continuity_delta":{}}`))
 testing.expect_value(t,scalar("SELECT json_array_length(state,'$.episodes') FROM continuity_revisions ORDER BY id DESC LIMIT 1"),2)
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"catchup"`),"Reaching the rebuild boundary must not discard the catch-up delta on the following batch.")
 assert(sqlite3_open_v2(path,&stage,2,nil)==0)
 assert(sqlite3_exec(stage,`UPDATE meta SET value='8' WHERE key IN ('boundary','cursor'); UPDATE meta SET value='22345678-1234-1234-1234-123456789abc' WHERE key='request_id'`,nil,nil,nil)==0)
 assert(sqlite3_close(stage)==0)
 assert(conversation_publish_rebuild(),string(conversation_error()))
 testing.expect_value(t,scalar("SELECT (SELECT created_at FROM episode_rebuilds ORDER BY id DESC LIMIT 1)>(SELECT created_at FROM continuity_revisions ORDER BY id DESC LIMIT 1)"),1)
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"22345678123412341234123456789abctrip"`),"A later rebuild must win over an existing normal snapshot at the same boundary.")
 assert(execute("DELETE FROM archive_events; DELETE FROM archive_transactions; DELETE FROM meta WHERE key='archive_version'"))
 assert(conversation_init(c))
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"22345678123412341234123456789abctrip"`))
 archive:=strings.clone_to_cstring(string(conversation_archive_delta(0)))
 defer delete(archive)
 restored:=strings.concatenate({dir,"/restored"})
 defer delete(restored)
 target:=strings.clone_to_cstring(restored)
 defer delete(target)
 assert(conversation_init(target))
 assert(conversation_apply_archive(archive),string(conversation_error()))
 testing.expect_value(t,scalar("SELECT count(*) FROM jobs WHERE processed=0"),0)
 testing.expect_value(t,scalar("SELECT max(through_id) FROM continuity_revisions"),8)
 testing.expect(t,strings.contains(string(conversation_context("")),`"key":"22345678123412341234123456789abctrip"`))
}

delta_test_payload :: proc(threads,roots:int,source:i64=1) -> string {
 builder:strings.Builder
 strings.write_string(&builder,`{"memories":[],"continuity_delta":{"threads":[`)
 for i in 0..<threads {
  if i>0 do strings.write_string(&builder,",")
  fmt.sbprintf(&builder,`{{"key":"thread-%d","status":"%s","text":"topic","source_ids":[%d]}}`,i,"resolved" if i<2 else "active",source)
 }
 strings.write_string(&builder,`],"episodes":[`)
 for i in 0..<roots {
  if i>0 do strings.write_string(&builder,",")
  fmt.sbprintf(&builder,`{{"key":"root-%d","text":"event","emotion":"","scene":"scene","scope":"real","source_ids":[%d]}}`,i,source)
 }
 strings.write_string(&builder,`]}}`)
 return strings.to_string(builder)
}

@(test)
continuity_delta_validates_before_eviction_and_preserves_search_and_archive :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-delta-window-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","出来事の話")>0)
 assert(conversation_add_message("assistant","覚える")>0)
 for invalid in ([]string{`{"threads":"[]"}`,`{"episodes":"[]"}`,`{"threads":null}`,`{"episodes":null}`,`{"relationship":null}`,`{"assistant_state":null}`}) {
  text:=fmt.aprintf(`{{"memories":[],"continuity_delta":%s}}`,invalid)
  payload:=strings.clone_to_cstring(text)
  testing.expect(t,!conversation_apply_job(1,payload),invalid)
  delete(payload)
  delete(text)
 }
 for counts in ([][2]int{{33,0},{0,129}}) {
  text:=delta_test_payload(counts[0],counts[1])
  payload:=strings.clone_to_cstring(text)
  testing.expect(t,!conversation_apply_job(1,payload))
  delete(payload)
  delete(text)
 }
 initial:=delta_test_payload(8,32)
 defer delete(initial)
 poisoned,replaced:=strings.replace_all(initial,`"key":"root-0","text":"event"`,`"key":"root-0","text":""`)
 assert(replaced)
 defer delete(poisoned)
 bad:=strings.clone_to_cstring(poisoned)
 defer delete(bad)
 testing.expect(t,!conversation_apply_job(1,bad),"Invalid entries must fail even when pruning would evict them.")
 testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),0)
 payload:=strings.clone_to_cstring(initial)
 defer delete(payload)
 assert(conversation_apply_job(1,payload),string(conversation_error()))
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_nodes"),32)
 testing.expect(t,strings.contains(string(conversation_memories("event")),`"key":"episode:root-0"`))
 testing.expect_value(t,scalar("SELECT json_array_length(state,'$.threads') FROM continuity_revisions ORDER BY id DESC LIMIT 1"),6)
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.threads[0].key')='thread-2' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.episodes[0].key')='root-2' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 assert(conversation_add_message("user","過去の場面を訂正")>0)
 assert(conversation_add_message("assistant","訂正を残す")>0)
 assert(conversation_apply_job(2,`{"memories":[],"continuity_delta":{"episodes":[{"key":"root-0","text":"corrected early event","emotion":"","scene":"scene","scope":"real","source_ids":[3]},{"key":"root-2","text":"corrected stable event","emotion":"","scene":"scene","scope":"real","source_ids":[3]}],"threads":[{"key":"thread-0","status":"active","text":"updated","source_ids":[3]}]}}`))
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.episodes[0].key')='root-3' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.episodes[29].key')='root-0' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect_value(t,scalar("SELECT count(*) FROM memories m JOIN memory_current c ON c.id=m.id WHERE key='episode:root-2' AND text LIKE '%corrected stable event%'"),1)
 archive:=strings.clone_to_cstring(string(conversation_archive_delta(0)))
 defer delete(archive)
 assert(conversation_init(c))
 testing.expect_value(t,scalar("SELECT json_extract(state,'$.episodes[29].key')='root-0' FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 restored:=strings.concatenate({dir,"/restored"})
 defer delete(restored)
 target:=strings.clone_to_cstring(restored)
 defer delete(target)
 assert(conversation_init(target))
 assert(conversation_apply_archive(archive),string(conversation_error()))
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_nodes"),34)
 testing.expect_value(t,scalar("SELECT json_array_length(state,'$.episodes') FROM continuity_revisions ORDER BY id DESC LIMIT 1"),30)
}

@(test)
continuity_delta_keeps_unchanged_state_and_updates_stable_keys :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-delta-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","旅行の相談")>0)
 assert(conversation_add_message("assistant","覚えておく")>0)
 assert(conversation_apply_job(1,CONTINUITY_FIXTURE))
 assert(conversation_add_message("user","金沢に決めた")>0)
 assert(conversation_add_message("assistant","楽しみだね")>0)
 testing.expect(t,conversation_apply_job(2,`{"memories":[],"continuity_delta":{"threads":[{"key":"trip","status":"resolved","text":"金沢に決定","source_ids":[3,4]}]}}`),string(conversation_error()))
 if string(conversation_error())!="" do return
 testing.expect_value(t,scalar("SELECT json_array_length(state,'$.episodes') FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect_value(t,scalar("SELECT json_array_length(state,'$.threads') FROM continuity_revisions ORDER BY id DESC LIMIT 1"),1)
 testing.expect(t,strings.contains(string(conversation_context("旅行")),"金沢に決定"))
 assert(conversation_add_message("user","別の話")>0)
 assert(conversation_add_message("assistant","聞くよ")>0)
 assert(conversation_apply_job(3,`{"memories":[],"continuity_delta":{"threads":[],"episodes":[]}}`))
 testing.expect(t,strings.contains(string(conversation_context("旅行")),"金沢に決定"))
}

@(test)
normal_memory_batches_stop_at_sixty_four_messages :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-batch64-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 for _ in 0..<40 {
  assert(conversation_add_message("user","話す")>0)
  assert(conversation_add_message("assistant","返事")>0)
 }
 {
 pending,ok:=parse_json(transmute([]byte)string(conversation_pending_job()))
 assert(ok)
 defer json.destroy_value(pending)
 testing.expect_value(t,len(pending.(json.Object)["messages"].(json.Array)),64)
 }
 testing.expect(t,!conversation_apply_job(40,`{"memories":[],"first_job_id":1}`))
 testing.expect_value(t,scalar("SELECT count(*) FROM jobs WHERE processed=1"),0)
 assert(conversation_apply_job(32,`{"memories":[],"first_job_id":1}`))
 testing.expect(t,strings.contains(string(conversation_pending_job()),`"first_job_id":33`))
}

@(test)
persona_completed_review_can_commit_after_scheduling_advances :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-persona-late-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 persona_test_pairs(6)
 testing.expect(t,strings.contains(string(conversation_pending_persona()),`"through_id":12`))
 persona_test_pairs(6)
 testing.expect(t,strings.contains(string(conversation_pending_persona()),`"through_id":24`))
 testing.expect(t,!conversation_apply_persona(26,`{"changes":[]}`))
 testing.expect(t,conversation_apply_persona(12,`{"changes":[{"field":"relationship","text":"考えを話せる","reason":"話し合いを重ねた","source_ids":[1,2,3,4]}]}`),string(conversation_error()))
 if string(conversation_error())!="" do return
 assert(conversation_apply_persona(12,`{"changes":[{"field":"relationship","text":"考えを話せる","reason":"話し合いを重ねた","source_ids":[1,2,3,4]}]}`))
 assert(conversation_add_message("user","新しい話")>0)
 assert(conversation_add_message("assistant","新しい返事")>0)
 testing.expect(t,!conversation_apply_persona(26,`{"changes":[]}`),"Unprocessed evidence remains invalid.")
 testing.expect_value(t,scalar("SELECT max(through_id) FROM persona_revisions"),12)
}

@(test)
continuity_delta_retains_relationship_and_rejects_unsupported_evidence :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-delta-trust-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","約束を破った")>0)
 assert(conversation_add_message("assistant","まだ用心する")>0)
 initial,replaced:=strings.replace_all(RELATIONSHIP_FIXTURE,`"episodes":[]`,`"episodes":[],"assistant_state":{"emotion":"ほっとして嬉しい","reason":"話してくれた","event":"話を聞いた","scope":"shared","source_ids":[1,2]}`)
 assert(replaced)
 defer delete(initial)
 payload:=strings.clone_to_cstring(initial)
 defer delete(payload)
 assert(conversation_apply_job(1,payload),string(conversation_error()))
 assert(conversation_add_message("user","新しい話")>0)
 assert(conversation_add_message("assistant","聞いている")>0)
 for bad in ([]cstring{
  `{"memories":[],"continuity":{},"continuity_delta":{}}`,
  `{"memories":[],"continuity_delta":{"relationship":null}}`,
  `{"memories":[],"continuity_delta":{"relationship":{"trust":"変わった","openness":"話したい","basis":"古い証拠だけ","source_ids":[1,2]}}}`,
  `{"memories":[],"continuity_delta":{"threads":[{"key":"bad","status":"active","text":"bad","source_ids":[999]}]}}`,
 }) {
  testing.expect(t,!conversation_apply_job(2,bad))
  testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),1)
 }
 assert(conversation_apply_job(2,`{"memories":[],"continuity_delta":{}}`))
 testing.expect(t,strings.contains(string(conversation_context("unrelated")),"まだ用心している"))
 testing.expect_value(t,string(conversation_assistant_emotion()),"ほっとして嬉しい")
 assert(conversation_add_message("user","今度は約束を守った")>0)
 assert(conversation_add_message("assistant","少し安心した")>0)
 assert(conversation_apply_job(3,`{"memories":[],"continuity_delta":{"relationship":{"trust":"少し安心した","openness":"話してみたい","basis":"新しいやり取り","source_ids":[5,6]}}}`))
 testing.expect(t,strings.contains(string(conversation_context("unrelated")),`"trust":"少し安心した"`))
}

@(test)
continuity_delta_indexes_trees_and_keeps_parent_and_node_budget_guards :: proc(t:^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-delta-tree-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","旅行の話")>0)
 assert(conversation_add_message("assistant","聞いている")>0)
 text,replaced:=strings.replace_all(TREE_FIXTURE,`"continuity":`,`"continuity_delta":`)
 assert(replaced)
 defer delete(text)
 payload:=strings.clone_to_cstring(text)
 defer delete(payload)
 assert(conversation_apply_job(1,payload),string(conversation_error()))
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_nodes"),5)
 assert(conversation_add_message("user","訂正がある")>0)
 assert(conversation_add_message("assistant","確認する")>0)
 testing.expect(t,!conversation_apply_job(2,`{"memories":[],"continuity_delta":{"episodes":[{"key":"kyoto-2026","text":"旅行","emotion":"","scene":"京都","scope":"real","source_ids":[3],"children":[{"key":"cafe","text":"新しい内容","emotion":"","scene":"喫茶店","scope":"real","source_ids":[3]}]}]}}`))
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_nodes"),5)
 overflow:=delta_test_payload(0,128,3)
 defer delete(overflow)
 nested,nested_ok:=strings.replace_all(overflow,`"key":"root-0","text":"event","emotion":"","scene":"scene","scope":"real","source_ids":[3]`,`"key":"root-0","text":"event","emotion":"","scene":"scene","scope":"real","source_ids":[3],"children":[{"key":"child","text":"detail","emotion":"","scene":"detail","scope":"real","source_ids":[3]}]`)
 assert(nested_ok)
 defer delete(nested)
 bad:=strings.clone_to_cstring(nested)
 defer delete(bad)
 testing.expect(t,!conversation_apply_job(2,bad),"128 roots plus a child exceed the total changed-node budget.")
 testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),1)
 testing.expect_value(t,scalar("SELECT count(*) FROM episode_nodes"),5)
}

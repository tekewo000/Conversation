package conversation

import "core:os"
import "core:encoding/json"
import "core:fmt"
import "core:strings"
import "core:testing"

RELATIONSHIP_FIXTURE :: `{"memories":[],"continuity":{"threads":[],"episodes":[],"relationship":{"trust":"まだ用心している","openness":"本音は少しずつ話したい","basis":"約束を破られて傷ついた。謝罪は受け止めたが、その後の行動を見たい。","source_ids":[1,2]}}}`

@(test)
relationship_survives_calm_mood_unrelated_turns_restart_and_archive :: proc(t: ^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-relationship-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","約束を破った。ごめんね。")>0)
 assert(conversation_add_reply("謝ってくれてありがとう。でも、まだ少し用心している。",`{"emotion":"落ち着いた","reason":"謝罪は受け止めた","event":"約束について話した","scope":"shared"}`)>0)
 assert(conversation_apply_job(1,RELATIONSHIP_FIXTURE),string(conversation_error()))
 for _ in 0..<35 {
  assert(conversation_add_message("user","別の話をしよう")>0)
  assert(conversation_add_message("assistant","雑談を続ける")>0)
  assert(conversation_apply_job(scalar("SELECT max(id) FROM jobs"),`{"memories":[],"continuity":{"threads":[],"episodes":[]}}`))
 }
 assert(conversation_init(c))
 output:=string(conversation_context("天気"))
 testing.expect(t,strings.contains(output,"まだ用心している") && strings.contains(output,"落ち着いた"),"Calm mood must not erase unresolved trust.")
 testing.expect(t,strings.contains(output,"約束を破った。ごめんね。"),"Relationship originals must survive the recent-message window.")
 assert(conversation_export(c))
 manifest_path:=strings.concatenate({dir,"/metadata.json"})
 defer delete(manifest_path)
 manifest_bytes,manifest_error:=os.read_entire_file(manifest_path,context.allocator)
 assert(manifest_error==nil)
 defer delete(manifest_bytes)
 manifest,parsed:=parse_json(manifest_bytes)
 assert(parsed)
 snapshot:=fmt.aprintf("%s/%s/continuity_revisions-000000.jsonl",dir,string(manifest.(json.Object)["snapshot"].(json.String)))
 json.destroy_value(manifest)
 defer delete(snapshot)
 bytes,read_error:=os.read_entire_file(snapshot,context.allocator)
 assert(read_error==nil)
 defer delete(bytes)
 testing.expect(t,strings.contains(string(bytes),"その後の行動を見たい"))
 delta:=strings.clone_to_cstring(string(conversation_archive_delta(0)))
 defer delete(delta)
 destination,e2:=os.make_directory_temp("","conversation-relationship-replay-*",context.allocator)
 assert(e2==nil)
 defer delete(destination)
 defer os.remove_all(destination)
 target:=strings.clone_to_cstring(destination)
 defer delete(target)
 assert(conversation_init(target))
 assert(conversation_apply_archive(delta),string(conversation_error()))
 testing.expect(t,strings.contains(string(conversation_context("天気")),"まだ用心している"))
 assert(conversation_add_message("user","その後は約束を守っているよ")>0)
 assert(conversation_add_message("assistant","少し安心して、自分から話せるようになってきた")>0)
 assert(conversation_apply_job(scalar("SELECT max(id) FROM jobs"),`{"memories":[],"continuity":{"threads":[],"episodes":[],"relationship":{"trust":"少し安心できる","openness":"自分から本音も話してみたい","basis":"以前の謝罪に加えて、その後約束を守るやりとりがあった。","source_ids":[1,2,73,74]}}}`),string(conversation_error()))
 output=string(conversation_context("天気"))
 testing.expect(t,strings.contains(output,"少し安心できる"))
 testing.expect(t,!strings.contains(output,`"trust":"まだ用心している"`))
}

@(test)
relationship_invalid_or_unsupported_changes_roll_back_the_job :: proc(t: ^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-relationship-invalid-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","ごめんね")>0)
 assert(conversation_add_message("assistant","まだ少しためらう")>0)
 for sources in ([7]string{`[]`,`[1]`,`[2]`,`[1,1,2]`,`[1,999]`,`[0,2]`,`[1.5,2]`}) {
  bad,replaced:=strings.replace_all(RELATIONSHIP_FIXTURE,`[1,2]`,sources)
  assert(replaced)
  payload:=strings.clone_to_cstring(bad)
  testing.expect(t,!conversation_apply_job(1,payload))
  delete(payload)
  delete(bad)
 }
 for invalid in ([3]string{`"trust":""`,`"trust":7`,`"trust":"まだ用心している","scope":"fiction"`}) {
  bad,replaced:=strings.replace_all(RELATIONSHIP_FIXTURE,`"trust":"まだ用心している"`,invalid)
  assert(replaced)
  payload:=strings.clone_to_cstring(bad)
  testing.expect(t,!conversation_apply_job(1,payload))
  delete(payload)
  delete(bad)
 }
 oversized,e2:=strings.repeat("a",769)
 assert(e2==nil)
 defer delete(oversized)
 too_long,replaced_long:=strings.replace_all(RELATIONSHIP_FIXTURE,"まだ用心している",oversized)
 assert(replaced_long)
 defer delete(too_long)
 too_long_c:=strings.clone_to_cstring(too_long)
 defer delete(too_long_c)
 testing.expect(t,!conversation_apply_job(1,too_long_c))
 testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),0)
 assert(conversation_apply_job(1,RELATIONSHIP_FIXTURE),string(conversation_error()))
 assert(conversation_add_message("user","今日は晴れたね")>0)
 assert(conversation_add_message("assistant","うん、晴れているね")>0)
 bad,replaced:=strings.replace_all(RELATIONSHIP_FIXTURE,"まだ用心している","全面的に信頼している")
 assert(replaced)
 defer delete(bad)
 payload:=strings.clone_to_cstring(bad)
 defer delete(payload)
 testing.expect(t,!conversation_apply_job(2,payload),"Changed trust needs fresh interaction evidence, not a reinterpretation of the same old sources.")
 testing.expect(t,!conversation_apply_job(2,`{"memories":[],"continuity":{"threads":[],"episodes":[],"relationship":null}}`))
 testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),1)
 testing.expect(t,strings.contains(string(conversation_pending_job()),`"id":2`))
 assert(conversation_apply_job(2,RELATIONSHIP_FIXTURE),"An unchanged state can carry its old evidence forward.")
}

@(test)
relationship_carry_forward_obeys_combined_state_budget :: proc(t: ^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-relationship-budget-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","大切な話をした")>0)
 assert(conversation_add_message("assistant","少し本音を話せた")>0)
 text,e2:=strings.repeat("a",768)
 assert(e2==nil)
 defer delete(text)
 initial:=fmt.aprintf(`{{"memories":[],"continuity":{{"threads":[],"episodes":[],"relationship":{{"trust":"%s","openness":"%s","basis":"%s%s","source_ids":[1,2]}}}}}}`,text,text,text,text)
 defer delete(initial)
 initial_c:=strings.clone_to_cstring(initial)
 defer delete(initial_c)
 assert(conversation_apply_job(1,initial_c),string(conversation_error()))
 assert(conversation_add_message("user","いくつか相談がある")>0)
 assert(conversation_add_message("assistant","順番に話そう")>0)
 topic:=strings.concatenate({text,text})
 defer delete(topic)
 threads:[6]struct {key,status,text:string,source_ids:[]i64}
 for key,i in ([6]string{"a","b","c","d","e","f"}) { threads[i]={key,"active",topic,[]i64{3}} }
 scene,_:=strings.repeat("s",180)
 defer delete(scene)
 episodes:[30]struct {key,text,emotion,scene,scope:string,source_ids:[]i64}
 keys:[30]string
 defer { for key in keys do delete(key) }
 for &episode,i in episodes {
  keys[i]=fmt.aprintf("scene-%d",i)
  episode={keys[i],topic,"",scene,"shared",[]i64{3}}
 }
 bytes,e3:=json.marshal(struct {memories:[0]i64,continuity:struct {threads:type_of(threads),episodes:type_of(episodes)}}{{},{threads,episodes}})
 assert(e3==nil)
 defer delete(bytes)
 testing.expect(t,len(bytes)<CONTINUITY_MAX_BYTES)
 payload:=strings.clone_to_cstring(string(bytes))
 defer delete(payload)
 testing.expect(t,!conversation_apply_job(2,payload),"Retaining relationship must not exceed the combined 64 KiB limit.")
 testing.expect(t,strings.contains(string(conversation_error()),"64 KiB"))
 testing.expect_value(t,scalar("SELECT count(*) FROM continuity_revisions"),1)
 testing.expect(t,strings.contains(string(conversation_pending_job()),`"id":2`))
}

@(test)
persona_reflection_uses_relationship_at_its_boundary_and_only_visible_evidence :: proc(t: ^testing.T) {
 dir,e:=os.make_directory_temp("","conversation-relationship-persona-*",context.allocator)
 assert(e==nil)
 defer delete(dir)
 defer os.remove_all(dir)
 c:=strings.clone_to_cstring(dir)
 defer delete(c)
 defer conversation_close()
 assert(conversation_init(c))
 assert(conversation_add_message("user","約束を破った。ごめんね。")>0)
 assert(conversation_add_message("assistant","まだ用心している")>0)
 assert(conversation_apply_job(1,RELATIONSHIP_FIXTURE),string(conversation_error()))
 persona_test_pairs(35)
 for through:i64=24;through<=72;through+=24 { assert(conversation_apply_persona(through,`{"changes":[]}`),string(conversation_error())) }
 persona_test_pairs(6)
 reflection:=string(conversation_pending_persona())
 review,parsed:=parse_json(transmute([]byte)reflection)
 assert(parsed)
 testing.expect_value(t,string(review.(json.Object)["relationship"].(json.Object)["trust"].(json.String)),"まだ用心している")
 json.destroy_value(review)
 testing.expect(t,strings.contains(reflection,"約束を破った。ごめんね。"),"Reflection must read the original old relationship evidence.")
 assert(!conversation_apply_persona(84,`{"changes":[{"field":"relationship","text":"関係の変化","reason":"根拠","source_ids":[5,6,73,74]}]}`),"A gap between old relationship evidence and recent messages is not visible evidence.")
 assert(conversation_apply_persona(84,`{"changes":[{"field":"relationship","text":"謝罪は受け止めたが慎重さが残る関係","reason":"以前の出来事とその後のやりとり","source_ids":[1,2,73,74]}]}`),string(conversation_error()))
 // The extraction queue can be ahead of the persona checkpoint.
 persona_test_pairs(18)
 assert(conversation_add_message("user","約束を守るやりとりを重ねたね")>0)
 assert(conversation_add_message("assistant","以前より信頼できる")>0)
 assert(conversation_apply_job(scalar("SELECT max(id) FROM jobs"),`{"memories":[],"continuity":{"threads":[],"episodes":[],"relationship":{"trust":"以前より信頼できる","openness":"少しずつ話せる","basis":"その後の会話","source_ids":[121,122]}}}`),string(conversation_error()))
 reflection=string(conversation_pending_persona())
 testing.expect(t,strings.contains(reflection,`"through_id":108`))
 testing.expect(t,strings.contains(reflection,"まだ用心している"),"Later relationship state must not leak across the review boundary.")
 testing.expect(t,!strings.contains(reflection,"以前より信頼できる"))
}
